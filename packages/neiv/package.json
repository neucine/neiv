{
  "name": "@neucine/neiv",
  "version": "0.1.3",
  "type": "module",
  "license": "MPL-2.0",
  "description": "Build macOS apps with Weiv interfaces and Cyna application code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neucine/neiv.git",
    "directory": "packages/neiv"
  },
  "homepage": "https://github.com/neucine/neiv#readme",
  "bugs": {
    "url": "https://github.com/neucine/neiv/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "macos",
    "desktop",
    "weiv",
    "cyna",
    "framework"
  ],
  "scripts": {
    "prepack": "node scripts/build-frontend.mjs && sh scripts/ensure-cyna-package.sh"
  },
  "exports": {
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    },
    "./slots": {
      "types": "./dist/slots.d.ts",
      "default": "./dist/slots.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "bin": {
    "neiv": "bin/neiv.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "weivjs": "0.1.2",
    "typescript": "5.9.3"
  },
  "files": [
    "README.md",
    "bin",
    "app-build.sh",
    "dist",
    "native",
    "cyna-dist/packages/neiv",
    "scripts"
  ]
}
