{
  "name": "neiv",
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "prepack": "node scripts/build-frontend.mjs && sh scripts/ensure-cyna-package.sh"
  },
  "exports": {
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    },
    "./slots": {
      "types": "./dist/slots.d.ts",
      "default": "./dist/slots.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "bin": {
    "neiv": "bin/neiv.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "weivjs": "0.1.2",
    "typescript": "5.9.3"
  },
  "files": [
    "README.md",
    "bin",
    "app-build.sh",
    "dist",
    "native",
    "cyna-dist/packages/neiv",
    "scripts"
  ]
}
